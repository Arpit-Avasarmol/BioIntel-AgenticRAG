# =============================================================================
# BioIntel Agent — environment configuration
# Copy to .env and adjust. Every value has a sensible default in biointel/common/config.py
# =============================================================================

# ---- General ----
BIOINTEL_ENV=local
LOG_LEVEL=INFO

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Simple shared-secret auth for the API. Clients send: `X-API-Key: <this>`
API_KEY=dev-local-key-change-me
# Redis-backed rate limit (requests per window, window seconds)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# MODELS (fully local — no external API keys required)
# Profiles: see configs/models.yaml. Override any single value here.
#   max     -> Qwen2.5 14B  + bge-large + bge-reranker-v2-m3   (16GB+ VRAM)   [DEFAULT]
#   balanced-> Llama 3.1 8B + bge-large + bge-reranker-v2-m3   (8-12GB VRAM)
#   lean    -> Llama 3.2 3B + bge-small + bge-reranker-base    (CPU-capable)
# =============================================================================
MODEL_PROFILE=max

# ---- LLM (Ollama) ----
# When running the API in Docker, Ollama on the host is reachable at host.docker.internal.
# When running CLI/tools on the host (make seed, biointel query), use localhost — see Makefile HOST_ENV.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:14b-instruct
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=120

# ---- Embeddings (in-process, sentence-transformers) ----
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu           # cuda | cpu | mps — Docker has no GPU; use cpu unless nvidia runtime is configured
EMBEDDING_BATCH_SIZE=32
# bge models recommend a query instruction prefix for retrieval
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# ---- Reranker (in-process, FlagEmbedding cross-encoder) ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_TOP_K=8

# =============================================================================
# VECTOR / SEARCH STORES
# =============================================================================
# Which dense vector backend the VectorStore interface uses: qdrant | milvus
VECTOR_BACKEND=qdrant

# ---- Qdrant (dense) ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=biointel_chunks

# ---- Milvus (optional dense alternative) ----
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=biointel_chunks

# ---- OpenSearch (BM25 keyword) ----
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Bi0nt3l!Os9xp
OPENSEARCH_INDEX=biointel_chunks
OPENSEARCH_VERIFY_CERTS=false

# ---- Retrieval / fusion ----
RETRIEVAL_DENSE_TOP_K=25
RETRIEVAL_SPARSE_TOP_K=25
RRF_K=60                       # Reciprocal Rank Fusion constant
RETRIEVAL_FINAL_TOP_K=8

# ---- Agent behavior ----
AGENT_AUTO_INGEST=true
AGENT_AUTO_INGEST_MODE=always   # always = ingest every query; if_needed = only when corpus lacks topic
AGENT_AUTO_INGEST_MAX_RECORDS=25   # per source during auto-ingest (keep low for interactive speed)

# =============================================================================
# INFRA
# =============================================================================
# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=biointel
POSTGRES_USER=biointel
POSTGRES_PASSWORD=biointel
# Full URL is derived from the above; override only if needed.
# DATABASE_URL=postgresql+psycopg://biointel:biointel@postgres:5432/biointel

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- MinIO (S3-compatible object store) ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=biointel-raw
MINIO_SECURE=false

# =============================================================================
# OBSERVABILITY (opt-in: `docker compose --profile observability up`)
# =============================================================================
OBS_ENABLED=false

# ---- Langfuse (LLM tracing) ----
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- OpenTelemetry ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=biointel-agent

# =============================================================================
# INGESTION — optional credentials (absence disables only that optional feature)
# =============================================================================
# NCBI E-utilities: optional API key raises rate limit from 3 to 10 req/s
NCBI_API_KEY=
NCBI_EMAIL=you@example.com
NCBI_TOOL=biointel-agent

# USPTO PatentSearch API (https://account.uspto.gov/api-manager/)
PATENTSVIEW_API_KEY=

# Google Patents Public Data via BigQuery (OPTIONAL connector; needs GCP creds).
# Path to a service-account JSON key. Leave empty to disable this connector.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
